# Copy to .env and fill in. Only WATCHMAN_SECRET is mandatory.

# Signs session cookies, webhook HMACs, and token hashes.
# Generate with:  openssl rand -hex 32
# Changing this invalidates every session and every outstanding invite.
WATCHMAN_SECRET=

# Public origin, without a trailing slash. Used to build the heartbeat URLs you
# paste into cron and the links inside alerts — leave it unset and those point at
# localhost, which is useless from a server.
WATCHMAN_URL=http://localhost:3000

# SQLite file. In Docker this must live on a mounted volume or you lose everything
# on the next container replacement.
WATCHMAN_DB_PATH=./data/watchman.db

# --- optional -----------------------------------------------------------------

# WATCHMAN_SCHEDULER=true          # false for a web-only process with no probing
# WATCHMAN_TICK_MS=5000            # how often to look for due monitors
# WATCHMAN_MAX_CONCURRENCY=12      # simultaneous probes
# WATCHMAN_RAW_RETENTION_DAYS=14   # individual check rows
# WATCHMAN_HOURLY_RETENTION_DAYS=90
# WATCHMAN_DAILY_RETENTION_DAYS=730
# WATCHMAN_SESSION_TTL_DAYS=30
# WATCHMAN_INVITE_TTL_HOURS=72
# WATCHMAN_USER_AGENT=Watchman/0.1 (+https://github.com/OWNER/watchman)
