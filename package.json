{
  "name": "watchman",
  "version": "0.2.2",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted end-to-end monitoring: synthetic checks, dead-man's-switch heartbeats, incidents, and status pages.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
